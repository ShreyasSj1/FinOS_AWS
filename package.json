{
  "name": "aws-finos",
  "version": "1.0.0",
  "private": true,
  "description": "AWS Cloud Financial Operations, Unit Economics, and Waste Guardrails Platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"green,blue\" \"npm --workspace=apps/api run dev\" \"npm --workspace=apps/web run dev\"",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build": "npm --workspace=apps/api run build && npm --workspace=apps/web run build",
    "start": "node apps/api/dist/index.js"
  },
  "keywords": [
    "aws",
    "finops",
    "cloud-cost",
    "unit-economics",
    "waste-detection",
    "guardrails"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
